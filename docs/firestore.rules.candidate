// Candidate for the existing native Firestore SDK. Review against the actual
// database edition and deployed rules before replacing rules in Firebase.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','isPro','interviewsUsed','streak','history','mastery','createdAt'])
        && request.resource.data.isPro == false;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','interviewsUsed','streak','history','mastery']);
      allow delete: if false;
    }
    match /stripeEvents/{event} { allow read, write: if false; }
    match /aiUsage/{usage} { allow read, write: if false; }
    match /testimonials/{review} { allow read: if true; allow write: if false; }
    match /meta/{item} { allow read: if true; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
